# Copy this file to .env and fill in real values.

# Required once you're ready to let the agent actually answer questions.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model used to answer questions (see README for alternatives)
CLAUDE_MODEL=claude-sonnet-5

# --- Filled in later, in the final phase, when you wire up Azure DevOps ---
# ADO_ORG_URL=https://dev.azure.com/your-org
# ADO_PROJECT=your-project
# ADO_PAT=your-personal-access-token

# --- Optional future connectors ---
# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# NOTION_API_KEY=
# SLACK_BOT_TOKEN=
